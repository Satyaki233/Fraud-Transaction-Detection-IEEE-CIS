{
  "datasets": [
    {
      "name": "overview",
      "displayName": "Training data overview",
      "queryLines": [
        "SELECT COUNT(*) AS transactions,\n",
        "       SUM(isFraud) AS frauds,\n",
        "       ROUND(100 * AVG(isFraud), 2) AS fraud_rate_pct\n",
        "FROM silver.train\n"
      ]
    },
    {
      "name": "by_product",
      "displayName": "Fraud rate by product",
      "queryLines": [
        "SELECT ProductCD,\n",
        "       COUNT(*) AS transactions,\n",
        "       ROUND(100 * AVG(isFraud), 2) AS fraud_rate_pct\n",
        "FROM silver.train\n",
        "GROUP BY ProductCD\n"
      ]
    },
    {
      "name": "by_card",
      "displayName": "Fraud rate by card type",
      "queryLines": [
        "SELECT CONCAT_WS(' ', COALESCE(card4, 'unknown'), COALESCE(card6, 'unknown')) AS card_type,\n",
        "       COUNT(*) AS transactions,\n",
        "       ROUND(100 * AVG(isFraud), 2) AS fraud_rate_pct\n",
        "FROM silver.train\n",
        "GROUP BY 1\n",
        "HAVING COUNT(*) >= 1000\n"
      ]
    },
    {
      "name": "by_email",
      "displayName": "Fraud rate by email domain",
      "queryLines": [
        "SELECT COALESCE(P_emaildomain, '(none)') AS email_domain,\n",
        "       COUNT(*) AS transactions,\n",
        "       ROUND(100 * AVG(isFraud), 2) AS fraud_rate_pct\n",
        "FROM silver.train\n",
        "GROUP BY 1\n",
        "HAVING COUNT(*) >= 1000\n"
      ]
    },
    {
      "name": "by_hour",
      "displayName": "Fraud rate by hour of day",
      "queryLines": [
        "SELECT hour,\n",
        "       COUNT(*) AS transactions,\n",
        "       ROUND(100 * AVG(isFraud), 2) AS fraud_rate_pct\n",
        "FROM silver.train\n",
        "GROUP BY hour\n"
      ]
    },
    {
      "name": "amount_dist",
      "displayName": "Amount distribution, fraud vs legit",
      "queryLines": [
        "-- share of each class per amount band, so the rare fraud class is comparable to legit\n",
        "SELECT CASE WHEN isFraud = 1 THEN 'Fraud' ELSE 'Legit' END AS class,\n",
        "       band_from,\n",
        "       ROUND(100 * COUNT(*) / SUM(COUNT(*)) OVER (PARTITION BY isFraud), 2) AS pct_of_class\n",
        "FROM (\n",
        "  SELECT isFraud,\n",
        "         CASE WHEN TransactionAmt < 25 THEN 0\n",
        "              WHEN TransactionAmt < 50 THEN 25\n",
        "              WHEN TransactionAmt < 100 THEN 50\n",
        "              WHEN TransactionAmt < 200 THEN 100\n",
        "              WHEN TransactionAmt < 500 THEN 200\n",
        "              ELSE 500 END AS band_from\n",
        "  FROM silver.train\n",
        ")\n",
        "GROUP BY isFraud, band_from\n"
      ]
    },
    {
      "name": "live_metrics",
      "displayName": "Live model metrics",
      "queryLines": [
        "-- the live model is the one 04_score used for gold.predictions\n",
        "SELECT version,\n",
        "       ROUND(auprc, 3) AS auprc,\n",
        "       ROUND(100 * precision, 1) AS precision_pct,\n",
        "       ROUND(100 * recall, 1) AS recall_pct,\n",
        "       caught, missed, false_alarms\n",
        "FROM gold.model_metrics\n",
        "WHERE version = (SELECT MAX(model_version) FROM gold.predictions)\n"
      ]
    },
    {
      "name": "versions",
      "displayName": "Metrics by model version",
      "queryLines": [
        "SELECT version, ROUND(auprc, 3) AS auprc\n",
        "FROM gold.model_metrics\n"
      ]
    },
    {
      "name": "score_dist",
      "displayName": "Score distribution, fraud vs legit",
      "queryLines": [
        "SELECT CASE WHEN actual = 1 THEN 'Fraud' ELSE 'Legit' END AS class,\n",
        "       LEAST(FLOOR(fraud_score * 20), 19) / 20 AS score_from,\n",
        "       ROUND(100 * COUNT(*) / SUM(COUNT(*)) OVER (PARTITION BY actual), 2) AS pct_of_class\n",
        "FROM gold.validation_predictions\n",
        "GROUP BY actual, score_from\n"
      ]
    },
    {
      "name": "pred_summary",
      "displayName": "Test-set scoring summary",
      "queryLines": [
        "SELECT MAX(model_version) AS model_version,\n",
        "       COUNT(*) AS scored,\n",
        "       SUM(flagged) AS flagged,\n",
        "       ROUND(100 * AVG(flagged), 2) AS flagged_pct\n",
        "FROM gold.predictions\n"
      ]
    },
    {
      "name": "flagged_daily",
      "displayName": "Flagged per day",
      "queryLines": [
        "SELECT DATE(event_ts) AS day,\n",
        "       COUNT(*) AS transactions,\n",
        "       SUM(flagged) AS flagged\n",
        "FROM gold.predictions\n",
        "GROUP BY 1\n"
      ]
    },
    {
      "name": "top_risky",
      "displayName": "Top 50 riskiest transactions",
      "queryLines": [
        "SELECT TransactionID,\n",
        "       event_ts,\n",
        "       ROUND(TransactionAmt, 2) AS amount,\n",
        "       ROUND(fraud_score, 4) AS fraud_score\n",
        "FROM gold.predictions\n",
        "ORDER BY fraud_score DESC\n",
        "LIMIT 50\n"
      ]
    },
    {
      "name": "layer_counts",
      "displayName": "Rows per layer",
      "queryLines": [
        "SELECT '1 bronze.train_transaction' AS table_name, COUNT(*) AS row_count FROM bronze.train_transaction\n",
        "UNION ALL SELECT '2 silver.train', COUNT(*) FROM silver.train\n",
        "UNION ALL SELECT '3 bronze.test_transaction', COUNT(*) FROM bronze.test_transaction\n",
        "UNION ALL SELECT '4 silver.test', COUNT(*) FROM silver.test\n",
        "UNION ALL SELECT '5 gold.predictions', COUNT(*) FROM gold.predictions\n"
      ]
    },
    {
      "name": "quality",
      "displayName": "Rows lost between layers",
      "queryLines": [
        "SELECT (SELECT COUNT(*) FROM bronze.train_transaction) - (SELECT COUNT(*) FROM silver.train) AS train_dropped,\n",
        "       (SELECT COUNT(*) FROM silver.test) - (SELECT COUNT(*) FROM gold.predictions) AS test_not_scored\n"
      ]
    }
  ],
